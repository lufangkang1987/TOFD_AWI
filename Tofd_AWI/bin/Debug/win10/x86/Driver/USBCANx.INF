[Version]
Signature = "$WINDOWS NT$"
Provider = %Provider%
DriverVer=03/24/2020,1.0.0.3
Class = %DeviceClassName%
ClassGUID = {0AD2B8A1-FFB6-413e-B1DF-21FBcDAE3C21}

CatalogFile=USBCANx.cat

;---------- Class Install ----------

[ControlFlags]
;ExcludeFromSelect = *

[ClassInstall32]
AddReg = UsbxxClass_AddReg

[UsbxxClass_AddReg]
HKR,,,0,%DeviceClassName%
HKR,,Icon,,"-5"
HKR,,DeviceCharacteristics,0x10001,0x100
HKR,,Security,,"D:P(A;;GA;;;WD)(A;;GA;;;SY)(A;;GA;;;BA)"

;---------- Device Install ---------- 

[Manufacturer]
%Manufacturer% = USBCANx_Mfg, NTx86, NTAMD64

[USBCANx_Mfg]
%USB\VID_0471&PID_9902.DeviceDesc%=USBCANx_Inst.NT, USB\VID_0471&PID_9902
%USB\VID_0471&PID_9903.DeviceDesc%=USBCANx_Inst.NT, USB\VID_0471&PID_9903
%USB\VID_0471&PID_9001.DeviceDesc%=USBCANx_Inst.NT, USB\VID_0471&PID_9001
%USB\VID_0471&PID_9101.DeviceDesc%=USBCANx_Inst.NT, USB\VID_0471&PID_9101
%USB\VID_0471&PID_9201.DeviceDesc%=USBCANx_Inst.NT, USB\VID_0471&PID_9201
%USB\VID_0471&PID_9202.DeviceDesc%=USBCANx_Inst.NT, USB\VID_0471&PID_9202

[USBCANx_Mfg.NTx86]
%USB\VID_0471&PID_9902.DeviceDesc%=USBCANx_Inst.NT, USB\VID_0471&PID_9902
%USB\VID_0471&PID_9903.DeviceDesc%=USBCANx_Inst.NT, USB\VID_0471&PID_9903
%USB\VID_0471&PID_9001.DeviceDesc%=USBCANx_Inst.NT, USB\VID_0471&PID_9001
%USB\VID_0471&PID_9101.DeviceDesc%=USBCANx_Inst.NT, USB\VID_0471&PID_9101
%USB\VID_0471&PID_9201.DeviceDesc%=USBCANx_Inst.NT, USB\VID_0471&PID_9201
%USB\VID_0471&PID_9202.DeviceDesc%=USBCANx_Inst.NT, USB\VID_0471&PID_9202

[USBCANx_Mfg.NTAMD64]
%USB\VID_0471&PID_9902.DeviceDesc%=USBCANx_Inst.NTAMD64, USB\VID_0471&PID_9902
%USB\VID_0471&PID_9903.DeviceDesc%=USBCANx_Inst.NTAMD64, USB\VID_0471&PID_9903
%USB\VID_0471&PID_9001.DeviceDesc%=USBCANx_Inst.NTAMD64, USB\VID_0471&PID_9001
%USB\VID_0471&PID_9101.DeviceDesc%=USBCANx_Inst.NTAMD64, USB\VID_0471&PID_9101
%USB\VID_0471&PID_9201.DeviceDesc%=USBCANx_Inst.NTAMD64, USB\VID_0471&PID_9201
%USB\VID_0471&PID_9202.DeviceDesc%=USBCANx_Inst.NTAMD64, USB\VID_0471&PID_9202

[USBCANx_Inst.NT]
AddReg = USBCANx_AddReg
CopyFiles = USBCANx_Drv


[USBCANx_Inst.NTAMD64]
AddReg = USBCANx_AddReg
CopyFiles = USBCANx_Drv


[USBCANx_AddReg]
;HKLM,SOFTWARE\Key,Name,,Value

[USBCANx_Drv]
lk_usbcan.sys,,,2


;---------- Service Install ----------

[USBCANx_Inst.NT.Services]
AddService = USBCANx,2,USBCANx_Svc

[USBCANx_Inst.NTAMD64.Services]
AddService = USBCANx,2,USBCANx_Svc

[USBCANx_Svc]
DisplayName    = %ServiceDescription%
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %12%\lk_usbcan.sys 

;---------- Source & Destination ----------

[SourceDisksNames]
1 = %DiskId1%,,,""

[SourceDisksFiles]
lk_usbcan.sys = 1,,

[DestinationDirs]
DefaultDestDir = 12

;---------- Strings & Constants ----------

[Strings]
DeviceClassName     = "LAIKECAN"
Provider            = "Nangjing LAIKE"
Manufacturer        = "Nanjing LAIKE Electronic Technology Co., Ltd."
USB\VID_0471&PID_9902.DeviceDesc="LCUSB-132B"
USB\VID_0471&PID_9903.DeviceDesc="LCUSB-131B"
USB\VID_0471&PID_9001.DeviceDesc="USBCAN-0x12x"
USB\VID_0471&PID_9101.DeviceDesc="USBCAN-C-0x12x"
USB\VID_0471&PID_9201.DeviceDesc="USBCAN-E-1x12x(1CAN)"
USB\VID_0471&PID_9202.DeviceDesc="USBCAN-E-1x22x(2CAN)"
DeviceDescription   = "USBCANx"
ServiceDescription  = "LAIKE USBCAN Driver "
DiskId1             = "LAIKE USBCAN Driver Installation Disk #1"

